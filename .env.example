# ============================================================================
# VeloCura Environment Configuration Example
# Copy this file to .env and provide your deployment secrets.
# NEVER commit real credentials to version control.
# ============================================================================

# Database Configuration (Neon Serverless PostgreSQL for Production)
DB_URL=jdbc:postgresql://ep-your-cluster.c-4.us-west-2.aws.neon.tech/velocura_db?sslmode=require
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=velocura_db_owner
DB_PASSWORD=replace_with_secure_db_password

# Authentication & JWT (Minimum 256-bit / 32 characters)
JWT_SECRET=replace_with_random_32_character_hex_secret
JWT_EXPIRATION_MS=86400000

# Administrator Credentials
ADMIN_EMAIL=admin@velocura.com
ADMIN_PASSWORD=replace_with_secure_admin_password

# Protected Health Information (PHI) AES-256 Encryption Secret
APP_ENCRYPTION_SECRET=replace_with_secure_aes_encryption_secret

# AI & External Integrations
GEMINI_API_KEY=replace_with_google_gemini_api_key
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
PAYMENT_MOCK_ENABLED=false

# Google Sign-In / Google OIDC Authentication
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Public Frontend / Server Configuration
PORT=8080
VITE_API_BASE_URL=https://velocura.onrender.com
